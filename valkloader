local function LoadGame()
	if closing then return end
	if not SelectedGame then
		setStatus("select a game first", C.bad)
		task.delay(2, function()
			tw(statusMsg, 0.3, { TextTransparency = 1 })
			task.delay(0.3, function() statusMsg.Visible = false end)
		end)
		return
	end

	local url = LOADSTRINGS[SelectedGame]
	if not url or url == "" then
		setStatus("script missing for " .. SelectedGame, C.bad)
		return
	end

	loadBtn.Text = "..."
	loadBtn.Active = false
	tw(loadBtn, 0.2, { BackgroundTransparency = 0.4, TextColor3 = C.mute })
	setStatus("summoning " .. SelectedGame .. "...", C.lilac)
	loadRing.Visible = true
	local spin = 0
	local spinConn = RunService.RenderStepped:Connect(function(dt)
		spin += dt * 280
		loadRing.Rotation = spin
	end)

	task.spawn(function()
		local success, err = pcall(function()
			local httpGet = syn and syn.request or http and http.request or http_request or request or fluxus and fluxus.request
			local body
			if game and game.HttpGet then
				local ok, res = pcall(function() return game:HttpGet(url) end)
				if ok and type(res) == "string" and #res > 50 then
					body = res
				end
			end
			if not body and httpGet then
				local ok, res = pcall(function()
					return httpGet({ Url = url, Method = "GET" })
				end)
				if ok and type(res) == "table" then
					body = res.Body or res.body
				elseif ok and type(res) == "string" then
					body = res
				end
			end
			assert(type(body) == "string" and #body > 50, "empty script / blocked http")
			local loader = loadstring or load
			assert(loader, "loadstring missing")
			local fn, compileErr = loader(body)
			assert(fn, tostring(compileErr))
			fn()
		end)

		if spinConn then spinConn:Disconnect() end
		loadRing.Visible = false

		if success then
			setStatus(SelectedGame .. " awakened", C.good)
			task.delay(0.7, function()
				animateClose(true)
			end)
		else
			setStatus("failed · " .. tostring(err):sub(1, 42), C.bad)
			loadBtn.Text = "LOAD"
			loadBtn.Active = true
			tw(loadBtn, 0.2, { BackgroundTransparency = 0.05, TextColor3 = C.moon })
			task.delay(3, function()
				tw(statusMsg, 0.3, { TextTransparency = 1 })
				task.delay(0.3, function() statusMsg.Visible = false end)
			end)
		end
	end)
end

