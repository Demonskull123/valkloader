local function closeDrop()
	if not dropList.Visible then return end
	local h = dropList.AbsoluteSize.Y
	tw(dropList, 0.22, { Size = UDim2.new(0.66, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.22, function()
		if dropList.Parent then dropList.Visible = false end
	end)
	dropArrow.Text = "v"
	tw(dropArrow, 0.2, { Rotation = 0 })
end

local function openDrop()
	dropList.Visible = true
	dropList.Size = UDim2.new(0.66, 0, 0, 0)
	local height, canvas = updateDropSize()
	dropScroll.CanvasSize = UDim2.new(0, 0, 0, canvas)
	tw(dropList, 0.3, { Size = UDim2.new(0.66, 0, 0, height) }, Enum.EasingStyle.Quint)
	dropArrow.Text = "^"
	tw(dropArrow, 0.2, { Rotation = 180 })
	for i, btn in ipairs(dropItems) do
		btn.TextTransparency = 1
		btn.BackgroundTransparency = 1
