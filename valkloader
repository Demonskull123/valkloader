local function tw(obj, t, props, style, dir)
	local ti = TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
	local twn = TweenService:Create(obj, ti, props)
	twn:Play()
	return twn
end
local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = o
	return c
end
local function stroke(o, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = th or 1
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
	return s
end
local function grad(o, c0, c1, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = rot or 90
	g.Parent = o
	return g
end
local function fr(parent, z)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = z or 2
	f.Parent = parent
	return f
end
local function bx(parent, col, z)
	local f = fr(parent, z)
	f.BackgroundColor3 = col
	f.BackgroundTransparency = 0
	return f
end
local function tx(parent, text, face, size, col)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text = text
	t.FontFace = face
	t.TextSize = size
	t.TextColor3 = col
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Parent = parent
	return t
end

local function glowLayers(inst, col, layers, step, rad, start)
	layers = layers or 3
	step = step or 3
	rad = rad or 14
	start = start or 0.4
	local out = {}
	for i = 1, layers do
		local g = Instance.new("Frame")
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		g.Size = UDim2.new(1, i * step * 2, 1, i * step * 2)
		g.BackgroundTransparency = 1
		g.BorderSizePixel = 0
		g.ZIndex = math.max(1, (inst.ZIndex or 2) - 1)
		g.Parent = inst
		corner(g, rad + i * step)
		out[i] = stroke(g, col, 1.3, start + i * 0.13)
	end
	return out
end

local function fadeIn(obj, delay, dur, fromY)
	obj.Visible = true
	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		local ot = obj.TextTransparency
		obj.TextTransparency = 1
		if obj:IsA("TextButton") then
			obj.BackgroundTransparency = 1
		end
		task.delay(delay or 0, function()
			if not obj.Parent then return end
			tw(obj, dur or 0.4, { TextTransparency = ot }, Enum.EasingStyle.Quint)
			if obj:IsA("TextButton") and obj.BackgroundColor3 then
				tw(obj, dur or 0.4, { BackgroundTransparency = 0.05 }, Enum.EasingStyle.Quint)
			end
		end)
	elseif obj:IsA("Frame") or obj:IsA("ImageLabel") then
		local bt = obj.BackgroundTransparency
		local pos = obj.Position
		obj.BackgroundTransparency = 1
		if fromY then
			obj.Position = pos + UDim2.fromOffset(0, fromY)
		end
		task.delay(delay or 0, function()
			if not obj.Parent then return end
			tw(obj, dur or 0.45, { BackgroundTransparency = bt, Position = pos }, Enum.EasingStyle.Quint)
		end)
	end
end

local function makeMoon(parent, size, z)
	local hold = fr(parent, z)
	hold.Size = UDim2.fromOffset(size, size)

	local auraRing = fr(hold, z)
	auraRing.AnchorPoint = Vector2.new(0.5, 0.5)
	auraRing.Position = UDim2.fromScale(0.5, 0.5)
	auraRing.Size = UDim2.fromOffset(size * 1.5, size * 1.5)
	corner(auraRing, size)
	local auraS = stroke(auraRing, C.aura, 1.2, 0.5)

	local moon = bx(hold, C.moon, z + 2)
	moon.AnchorPoint = Vector2.new(0.5, 0.5)
	moon.Position = UDim2.fromScale(0.5, 0.5)
	moon.Size = UDim2.fromOffset(size, size)
	corner(moon, size)
	grad(moon, Color3.fromRGB(255, 250, 255), Color3.fromRGB(180, 160, 230), 135)
	stroke(moon, C.lilac, 1, 0.35)

	local shadow = bx(hold, C.void, z + 3)
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, size * 0.18, 0.5, -size * 0.08)
	shadow.Size = UDim2.fromOffset(size * 0.78, size * 0.78)
	shadow.BackgroundTransparency = 0.08
	corner(shadow, size)

	local spark = bx(hold, C.lilac, z + 4)
	spark.AnchorPoint = Vector2.new(0.5, 0.5)
	spark.Position = UDim2.new(0.5, -size * 0.22, 0.5, -size * 0.2)
	spark.Size = UDim2.fromOffset(size * 0.12, size * 0.12)
	spark.BackgroundTransparency = 0.25
	corner(spark, size)

	local t0 = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not hold.Parent then return end
		t0 += dt
		local pulse = 0.5 + math.sin(t0 * 1.5) * 0.5
		auraRing.Size = UDim2.fromOffset(size * (1.35 + pulse * 0.3), size * (1.35 + pulse * 0.3))
		auraS.Transparency = 0.3 + pulse * 0.45
		spark.BackgroundTransparency = 0.1 + pulse * 0.4
	end)
	hold.Destroying:Connect(function()
		pcall(function() conn:Disconnect() end)
	end)
	return hold
end

local function spawnStars(parent, count, z)
	local stars = {}
	for i = 1, count do
		local s = bx(parent, C.lilac, z)
		local sz = math.random(1, 3)
		s.Size = UDim2.fromOffset(sz, sz)
		s.Position = UDim2.new(math.random(), 0, math.random(), 0)
		s.BackgroundTransparency = 1
		s.AnchorPoint = Vector2.new(0.5, 0.5)
		corner(s, 10)
		stars[i] = { f = s, phase = math.random() * math.pi * 2, speed = 0.5 + math.random() * 1.6, delay = math.random() * 0.8 }
	end
	local t0 = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not parent.Parent then return end
		t0 += dt
		for _, st in ipairs(stars) do
			if st.f.Parent and t0 > st.delay then
				local a = 0.2 + (math.sin(t0 * st.speed + st.phase) * 0.5 + 0.5) * 0.6
				st.f.BackgroundTransparency = 1 - a
			end
		end
	end)
	parent.Destroying:Connect(function()
		pcall(function() conn:Disconnect() end)
	end)
end

