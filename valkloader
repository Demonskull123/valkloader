	draggingUI = true
	dragStart = UserInputService:GetMouseLocation()
	startPos = main.AbsolutePosition
end)
UserInputService.InputChanged:Connect(function(inp)
	if not draggingUI then return end
	if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
		local delta = UserInputService:GetMouseLocation() - dragStart
		main.Position = UDim2.fromOffset(startPos.X + delta.X, startPos.Y + delta.Y)
		main.AnchorPoint = Vector2.new(0, 0)
	end
end)
UserInputService.InputEnded:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		draggingUI = false
	end
end)

UserInputService.InputBegan:Connect(function(inp, gp)
	if gp or closing then return end
	if inp.KeyCode == Enum.KeyCode.RightControl then
		if main.Visible then
			animateClose(false)
		else
			main.Visible = true
			main.Size = UDim2.fromOffset(0, 0)
			main.BackgroundTransparency = 1
			tw(main, 0.4, { Size = UDim2.fromOffset(winW, winH), BackgroundTransparency = 0.05 }, Enum.EasingStyle.Back)
			tw(mainStroke, 0.4, { Transparency = 0.25 })
			for i, g in ipairs(mainGlows) do
				tw(g, 0.4, { Transparency = 0.35 + i * 0.12 })
			end
		end
	end
end)

local function playEntrance()
	main.Visible = true
	main.Size = UDim2.fromOffset(0, 0)
	main.BackgroundTransparency = 1
	mainStroke.Transparency = 1

	tw(main, 0.55, {
		Size = UDim2.fromOffset(winW, winH),
		BackgroundTransparency = 0.05,
	}, Enum.EasingStyle.Back)

	tw(mainStroke, 0.5, { Transparency = 0.25 })
	for i, g in ipairs(mainGlows) do
		task.delay(0.05 * i, function()
			tw(g, 0.5, { Transparency = 0.35 + i * 0.12 })
		end)
	end

	task.delay(0.15, function()
		tw(night, 0.4, { BackgroundTransparency = 0.35 })
		tw(haze, 0.5, { BackgroundTransparency = 0.88 })
		tw(top, 0.4, { BackgroundTransparency = 0.2 })
	end)

	task.delay(0.25, function()
		moon.Visible = true
		tw(title, 0.4, { TextTransparency = 0 }, Enum.EasingStyle.Quint)
	end)
	task.delay(0.35, function()
		tw(sub, 0.4, { TextTransparency = 0 }, Enum.EasingStyle.Quint)
	end)
	task.delay(0.4, function()
		tw(closeBtn, 0.35, { TextTransparency = 0, BackgroundTransparency = 0.3 })
	end)
	task.delay(0.48, function()
		tw(gameLbl, 0.35, { TextTransparency = 0 })
	end)
	task.delay(0.55, function()
		tw(dropFrame, 0.4, { BackgroundTransparency = 0.1 }, Enum.EasingStyle.Quint)
		tw(dropStroke, 0.4, { Transparency = 0.35 })
		tw(dropBtn, 0.35, { TextTransparency = 0 })
		tw(dropArrow, 0.35, { TextTransparency = 0 })
	end)
	task.delay(0.62, function()
		tw(loadBtn, 0.4, { BackgroundTransparency = 0.05, TextTransparency = 0 }, Enum.EasingStyle.Quint)
		tw(loadStroke, 0.4, { Transparency = 0.2 })
		for i, g in ipairs(loadGlows) do
			tw(g, 0.4, { Transparency = 0.45 + i * 0.15 })
		end
	end)
	task.delay(0.75, function()
		tw(foot, 0.4, { TextTransparency = 0 })
	end)
end

local function boot()
	local bootFrame = bx(gui, C.void, 80)
	bootFrame.Size = UDim2.fromOffset(0, 0)
	bootFrame.Position = UDim2.fromScale(0.5, 0.5)
	bootFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	bootFrame.BackgroundTransparency = 1
	corner(bootFrame, 16)
	local bootStroke = stroke(bootFrame, C.violet, 1.6, 1)
	local bootGlows = glowLayers(bootFrame, C.aura, 4, 5, 16, 0.95)
	spawnStars(bootFrame, 16, 81)

	tw(bootFrame, 0.45, {
		Size = UDim2.fromOffset(320, 150),
		BackgroundTransparency = 0,
	}, Enum.EasingStyle.Back)
	tw(bootStroke, 0.45, { Transparency = 0.25 })
	for i, g in ipairs(bootGlows) do
		task.delay(0.06 * i, function()
			tw(g, 0.4, { Transparency = 0.3 + i * 0.12 })
		end)
	end

	local moonB = makeMoon(bootFrame, 40, 82)
	moonB.Position = UDim2.fromOffset(22, 22)
	moonB.Visible = false

	local bt = tx(bootFrame, "VALKYRIE", F_D, 20, C.moon)
	bt.Size = UDim2.new(1, -80, 0, 28)
	bt.Position = UDim2.fromOffset(74, 24)
	bt.ZIndex = 83
	bt.TextTransparency = 1

	local st = tx(bootFrame, "awakening the night...", F_R, 12, C.lilac)
	st.Size = UDim2.new(1, -44, 0, 18)
	st.Position = UDim2.fromOffset(22, 78)
	st.ZIndex = 83
	st.TextTransparency = 1

	local barBg = bx(bootFrame, C.surface, 83)
	barBg.Size = UDim2.new(1, -44, 0, 6)
	barBg.Position = UDim2.fromOffset(22, 112)
	barBg.BackgroundTransparency = 1
	corner(barBg, 4)
	local barBgS = stroke(barBg, C.line, 1, 1)

	local bar = bx(barBg, C.orchid, 84)
	bar.Size = UDim2.new(0, 0, 1, 0)
	corner(bar, 4)
	grad(bar, C.lilac, C.violet, 0)

	task.delay(0.2, function()
		moonB.Visible = true
		tw(bt, 0.4, { TextTransparency = 0 })
	end)
	task.delay(0.35, function()
		tw(st, 0.35, { TextTransparency = 0 })
		tw(barBg, 0.35, { BackgroundTransparency = 0 })
		tw(barBgS, 0.35, { Transparency = 0.5 })
	end)

	local steps = {
		"opening the void",
		"calling the moon",
		"binding scripts",
		"night is ready",
	}

	task.spawn(function()
		task.wait(0.5)
		for i, step in ipairs(steps) do
			st.TextTransparency = 0.5
			st.Text = step
			tw(st, 0.2, { TextTransparency = 0 })
			tw(bar, 0.38, { Size = UDim2.new(i / #steps, 0, 1, 0) }, Enum.EasingStyle.Quint)
			task.wait(0.34)
		end
		-- close boot
		tw(bt, 0.2, { TextTransparency = 1 })
		tw(st, 0.2, { TextTransparency = 1 })
		tw(barBg, 0.25, { BackgroundTransparency = 1 })
		tw(bootStroke, 0.3, { Transparency = 1 })
		for _, g in ipairs(bootGlows) do tw(g, 0.3, { Transparency = 1 }) end
		tw(bootFrame, 0.35, {
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.wait(0.38)
		pcall(function() bootFrame:Destroy() end)
		playEntrance()
	end)
end

boot()
