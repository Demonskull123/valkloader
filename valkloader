local draggingUI = false
local dragStart, startPos
local DZ = Instance.new("TextButton")
DZ.Size = UDim2.new(1, -50, 1, 0)
DZ.BackgroundTransparency = 1
DZ.Text = ""
DZ.ZIndex = 11
